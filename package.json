    "check:config": "node scripts/check-config.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:081": "node scripts/check-081.mjs",
    "check:082": "node scripts/check-082.mjs",
    "check:083": "node scripts/check-083.mjs",
    "check:084": "node scripts/check-084.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
